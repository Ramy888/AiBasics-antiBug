# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required. Server-side only. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Seals each drill's hidden answer. Optional locally (a random key is used per run);
# required when deployed. Any long random string, e.g. `openssl rand -hex 32`.
ANTIBUG_SECRET=

# Optional. Raises GitHub's API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Optional. Drills allowed per visitor per hour (default 10). Raise it for local testing.
# When deployed, it's set in wrangler.jsonc; the other values go in `npx wrangler secret put`.
ANTIBUG_DRILLS_PER_HOUR=
